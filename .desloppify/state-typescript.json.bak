    "review::.::holistic::type_safety::tsconfig-missing-strict-mode": {
      "id": "review::.::holistic::type_safety::tsconfig-missing-strict-mode",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "tsconfig.app.json is missing strict: true (and strictNullChecks), so null/undefined are silently assignable to all typed variables across the entire codebase",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "tsconfig.app.json"
        ],
        "evidence": [
          "tsconfig.app.json has noUnusedLocals, noUnusedParameters, noFallthroughCasesInSwitch but omits strict, strictNullChecks, noImplicitAny, strictFunctionTypes, and other strict-mode flags",
          "Without strictNullChecks, a function typed as -> string could return null at runtime without a compiler error, making all return type annotations unreliable for null safety",
          "TypeScript ~6.0.2 is used, where strict mode has been the recommended default for many years"
        ],
        "suggestion": "Add 'strict: true' (or at minimum 'strictNullChecks: true') to the compilerOptions in tsconfig.app.json. This will cause any null/undefined assignments to incompatible types to fail compilation, making all existing type annotations actually enforceable.",
        "reasoning": "",
        "summary_hash": "fc033ace"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-06-30T03:28:02+00:00",
