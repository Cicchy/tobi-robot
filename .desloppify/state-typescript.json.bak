    "review::.::holistic::cross_module_architecture::app-tsx-hub-module": {
      "id": "review::.::holistic::cross_module_architecture::app-tsx-hub-module",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "App.tsx (407 LOC) acts as a hub module combining scene data, Hero component, footer, and scroll-driven state management in a single file",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/App.tsx"
        ],
        "evidence": [
          "App.tsx defines 6 scene objects with inline JSX panels and content at module scope (lines 28-212)",
          "App.tsx contains both the Hero component (lines 214-262) and the App component (lines 264-405)",
          "Hardcoded color values (e.g. '#e54833', '#3e7ce4', '#f9cc48', '#6a9cf4', '#2d8c47', '#e8751a') appear ~50 times across the component, embedded in JSX rather than extracted to a theme or data config",
          "App.tsx represents ~85% of production code (407 of ~479 LOC)"
        ],
        "suggestion": "Extract the scenes data array and hardcoded color palette into a separate data file (e.g. src/data/scenes.ts or src/data/site-content.ts). This separates configuration/presentation data from rendering logic and reduces the blast radius for content changes.",
        "reasoning": "",
        "summary_hash": "5ea36451"
      },
      "status": "fixed",
      "note": "Extracted Scene interface, Card component, and scenes data array into src/data/scenes.tsx \u2014 reduces App.tsx from 407 to 201 LOC",
